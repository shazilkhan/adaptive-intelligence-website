    "singularName": "service-list",
    "pluralName": "service-lists",
    "displayName": "Service List"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "subtitle": {
