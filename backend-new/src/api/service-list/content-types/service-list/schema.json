      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "color": {
      "type": "string"
    },
    "buttonText": {
      "type": "string"
    },
    "buttonUrl": {
      "type": "string"
    },
    "features": {
      "type": "component",
      "component": "shared.bullet-point",
      "repeatable": true
    },
    "footer_text": {
      "type": "text"
    },
    "order": {
      "type": "integer"
    },
    "isNew": {
      "type": "boolean",
      "default": false
