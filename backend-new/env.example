# Strapi – example env for local dev and AWS production reference
# Copy to .env and fill values. Never commit .env.

# Server
HOST=0.0.0.0
PORT=1337
NODE_ENV=development

# App (required – generate with: openssl rand -base64 32)
APP_KEYS=key1,key2,key3,key4
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# Database – local SQLite (default)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Database – PostgreSQL (Render / AWS RDS)
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=strapi
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=
# DATABASE_SSL=false
# Or single URL:
# DATABASE_URL=postgres://user:pass@host:5432/strapi

# Public files path (optional – default ./public; Render uses /data/public)
# STRAPI_PUBLIC_PATH=./public

# AWS S3 uploads (optional – if set, uploads go to S3 instead of local)
# AWS_ACCESS_KEY_ID=
# AWS_ACCESS_SECRET=
# AWS_REGION=us-east-1
# AWS_BUCKET=
# AWS_ACL=public-read
# CDN_URL=  (optional, e.g. https://d123.cloudfront.net)
